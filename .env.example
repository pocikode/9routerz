# 9Routerz environment contract
#
# Mirrors 9router/.env.example, with values adjusted for running 9routerz
# (bun run dev / build / start) instead of the upstream Docker image.
#
# Every variable here is read by the 9router runtime. Copy to .env and edit:
#   cp .env.example .env
#
# Where this file is loaded from: the standalone server and `next dev` read
# .env from the process working directory, which is .work/9router. scripts/sync.mjs
# copies this file there on every sync, so edit it HERE, not in .work/.

# ─── Required ────────────────────────────────────────────────────────────────
# Signing key for dashboard session JWTs (src/lib/auth/dashboardSession.js).
# If empty, 9router generates ~/.9router/jwt-secret on first boot and reuses it.
# Set it explicitly when running more than one instance against the same data.
JWT_SECRET=change-me-to-a-long-random-secret

# First-login password, used only until a password is stored in the DB
# (src/app/api/auth/login/route.js). Leaving this unset keeps the built-in
# default ("123456"), and a remote login with that default is refused until the
# password is changed locally.
INITIAL_PASSWORD=change-me

# Where the SQLite DB, logs, machine-id and model catalog live
# (src/lib/dataDir.js). Relative paths resolve against the process cwd.
# Leave EMPTY to use the default ~/.9router (shared with a stock 9router
# install, so existing connections/providers carry over).
# The upstream Docker image uses /var/lib/9router; this repo runs on the host.
DATA_DIR=

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Port for the dashboard + LLM API. `bun run dev` uses 20127 (set by the script);
# `bun run start` reads PORT from here, defaulting to 20127.
PORT=20127

NODE_ENV=production

# Bind address for the standalone server. 0.0.0.0 exposes the LAN.
HOSTNAME=0.0.0.0

# ─── Security / ops ──────────────────────────────────────────────────────────
# HMAC secret embedded in generated API keys (src/shared/utils/apiKey.js).
# Changing it invalidates previously generated sk-{machineId}-{keyId}-{crc} keys.
API_KEY_SECRET=endpoint-proxy-api-key-secret

# Salt for the machine id that identifies this install
# (src/shared/utils/machineId.js). It is embedded in every generated API key
# (sk-{machineId}-{keyId}-{crc}); changing it changes newly generated keys'
# machine id, so existing keys stay valid but no longer match new ones.
# The internal CLI/dashboard token uses a separate fixed salt and is unaffected.
MACHINE_ID_SALT=endpoint-proxy-salt

# Persist request/response logs for the dashboard (src/app/api/settings/route.js).
ENABLE_REQUEST_LOGS=false

# Observability row retention is on unless explicitly "false"
# (src/lib/db/repos/requestDetailsRepo.js).
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_RECORDS=1000
OBSERVABILITY_BATCH_SIZE=20
OBSERVABILITY_FLUSH_INTERVAL_MS=5000
OBSERVABILITY_MAX_JSON_SIZE=5

# Force the dashboard session cookie to Secure (set true behind HTTPS).
AUTH_COOKIE_SECURE=false

# Trust X-Forwarded-For for login rate limiting (set true behind a reverse proxy).
TRUST_PROXY=false

# Public base URL used to build OIDC/SAML callbacks and internal self-calls.
BASE_URL=http://localhost:20127

# Cloud sync target (src/lib/db/repos/settingsRepo.js).
CLOUD_URL=https://9router.com
NEXT_PUBLIC_BASE_URL=http://localhost:20127
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# ─── Behaviour toggles ───────────────────────────────────────────────────────
# Trace logging verbosity: DEBUG | INFO | WARN | ERROR (src/sse/utils/logger.js).
LOG_LEVEL=INFO

# Set to "off" to stop the background models.dev catalog sync.
MODEL_CATALOG_SYNC=on

# Set to "true" to skip the background OAuth token-refresh scheduler.
DISABLE_BACKGROUND_TOKEN_REFRESH=false

# Accept self-signed / invalid TLS certs for upstream provider calls.
STRICT_SSL=true

# Max JSON body accepted by the Next proxy layer (next.config.mjs).
NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb

# Secret required by POST /api/shutdown (src/app/api/shutdown/route.js).
# SHUTDOWN_SECRET=

# ─── Proxy ───────────────────────────────────────────────────────────────────
# Outbound proxy for upstream provider calls. Lowercase variants are also
# supported (http_proxy, https_proxy, all_proxy, no_proxy). The dashboard
# settings UI can override these per connection or per proxy pool.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ─── Optional integrations ───────────────────────────────────────────────────
# Endpoint for the built-in SearXNG web-search provider
# (open-sse/config/runtimeConfig.js).
# SEARXNG_URL=http://localhost:8888/search

# External compression proxy (open-sse/rtk/headroom.js). Off unless enabled in
# the dashboard's Token Saver settings.
# HEADROOM_URL=http://localhost:8787

# ─── Advanced (rarely needed) ────────────────────────────────────────────────
# OAuth client id override for Kimi (forks running their own OAuth app).
# KIMI_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_ID=

# Fallback API key used by the Azure executor when a connection has none.
# OPENAI_API_KEY=

# Base URL the MITM handlers call back into (default http://localhost:20128).
# MITM_ROUTER_BASE=http://localhost:20127

# Background OAuth refresh cadence, in milliseconds (default 1500 base delay).
# BG_REFRESH_DELAY_MS=1500

# Resolve Google project ids eagerly on token refresh instead of lazily.
# EAGER_PROJECT_ID_REFRESH=false

# ─── 9routerz overlay ────────────────────────────────────────────────────────
# No variables are required for provider clones: clone definitions live in the
# existing providerNodes SQLite table, so no extra configuration is needed.
